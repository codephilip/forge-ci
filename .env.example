# Forge settings. What each credential is for and how to create it:
# https://github.com/codephilip/forge-ci#credentials-what-youll-be-asked-for-and-why
# Every setting: docs/configuration.md

# ---- Required -------------------------------------------------------------
# GitHub token. Classic PAT with `repo` (private repos) — add `admin:org` to
# list an org's self-hosted runners. Public repos only? No scopes needed.
GITHUB_TOKEN=
# Repos to watch, comma-separated.
FORGE_REPOS=owner/repo,owner/another-repo

# ---- Optional -------------------------------------------------------------
# Also watch every private repo in these orgs pushed to in the last 30 days,
# and list the orgs' self-hosted runners.
# FORGE_ORGS=my-org
# Repos whose repo-level self-hosted runners should appear in the fleet strip.
# FORGE_RUNNER_REPOS=owner/repo
# FORGE_TITLE=Acme CI
# FORGE_URL=http://localhost:8080          # used for links in emails

# AI explainer + chat (Anthropic API key with credit).
# ANTHROPIC_API_KEY=

# Failure / recovery / runner-offline emails — Resend or any SMTP server.
# NOTIFY_TO=you@example.com
# NOTIFY_FROM=Forge CI <ci@example.com>
# RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Runner host health from Prometheus node-exporter.
# PROM_URL=http://prometheus:9090
# PROM_INSTANCE=10.0.0.5:9100
# FORGE_HOST_LABEL=build-box
